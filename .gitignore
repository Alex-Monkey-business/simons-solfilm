# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Netlify CLI state and its deploy bundles — build output, regenerated on demand
.netlify/
deploy-*.zip

# Stock footage used to generate the site video (15 MB, re-downloadable).
# Kept out of history deliberately; back it up outside git if it matters.
_video-source/

# No blanket "* 2.*" rule here. It was tried and it silently swallowed
# public/brand/SS NY LOGO 2.JPG — Simon's original file, named by him, which
# every logo SVG is derived from. The duplicates it was meant to catch came
# from the project's stint in iCloud and were a one-off; they are gone.
